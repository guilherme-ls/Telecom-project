clear;
close all;
%%%%%%%%%%%%%%%% Fiber Constants

alpha = 0.2; % db/km
dispersion_0 = 0; % ps/nm/km
dispersion_slope = 0;
fiber_length = 1; % km


%%%%%%%%%%%%%%%% Physical Constants

c = physconst("LightSpeed");

%%%%%%%%%% Transmission Constants 

f_0 = 193e12; % Hz 
wavelength_0 = (c / f_0) * 1e9; % nm

f = 1e9; % Hz
wavelength = (c / f) * 1e9; % nm

%%%%%%%%%% Dispersion Transfer Function

dispersion = dispersion_0 + dispersion_slope*(wavelength - wavelength_0);

beta_2 = - dispersion * wavelength^2 / (2*pi*c);
beta_3 = dispersion_slope * wavelength^4 / (2*pi*c)^2;

beta = @(dw) beta_2*dw*dw/2 + beta_3*dw*dw*dw/2;
transfer_fun = @(dw) exp((-alpha -1j*beta(dw))*fiber_length);


%%%%%%%%%% Time/Frequency Vector 

f_max = 2*f;
N_points = 10000;

t_vec = (-N_points:1:N_points)/f_max;
f_vec = 1./t_vec;

%%%%%%%%%%% Pulse Signal Creation

[] = gauspuls(t_vec, f, 0.6);
pulse_fft = fft(pulse);

%%%%%%%%%%% Simulated Dispersion

fiber_trans = zeros(1, length(f_vec));

for ii=1:length(f_vec)
    fiber_trans(ii) = transfer_fun(f_vec(ii));
end

pulse_out_fft = pulse .* fiber_trans;

pulse_out = ifft(pulse_out_fft);

figure();
subplot(2,1,1);
plot(f_vec, abs(fiber_trans));
subplot(2,1,2);
plot(f_vec, angle(fiber_trans));

figure();
subplot(2,1,1);
plot(t_vec, pulse);
subplot(2,1,2);
plot(t_vec, pulse_out);

%%%%%%%%%%% Dispersion Calculation

